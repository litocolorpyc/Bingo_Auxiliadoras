# --- Supabase ---
# Connection string en modo "Transaction pooler" (puerto 6543), con la contraseña real.
DATABASE_URL=postgresql://postgres.xxxx:[TU-CONTRASEÑA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://xxxx.supabase.co
# service_role key: secreta, solo en el servidor (nunca en el navegador ni en GitHub).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=comprobantes

# --- Administración ---
ADMIN_PASSWORD=cambia-esta-clave
# Opcional: clave para firmar sesiones. Si se omite, se deriva de ADMIN_PASSWORD.
SESSION_SECRET=

# --- WhatsApp (Meta Cloud API). Vacío = envío con enlace manual ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PLANTILLA=
CODIGO_PAIS=58
