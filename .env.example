# Contraseña del panel de administración (obligatoria en producción)
ADMIN_PASSWORD=cambia-esta-clave
PORT=3000

# Código de país por defecto para números locales que empiezan en 0 (58 = Venezuela)
CODIGO_PAIS=58

# WhatsApp Cloud API (Meta). Si se dejan vacías, las tablas se envían con enlace manual.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Nombre de una plantilla aprobada por Meta con 2 variables: nombre y seriales.
# Sin plantilla se envía texto libre (solo funciona dentro de las 24 h de la última respuesta del comprador).
WHATSAPP_PLANTILLA=
