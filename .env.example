# Todas estas variables las crea Vercel al conectar Neon y Blob al proyecto (Settings → Environment Variables).
# Para desarrollo local, copia los valores desde Vercel con: vercel env pull .env

# Neon Postgres (Marketplace de Vercel)
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.sa-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel Blob privado (se crea al conectar la tienda Blob al proyecto)
BLOB_READ_WRITE_TOKEN=

# Administración
ADMIN_PASSWORD=cambia-esta-clave
# Opcional: clave para firmar sesiones. Si se omite, se deriva de ADMIN_PASSWORD.
SESSION_SECRET=

# WhatsApp (Meta Cloud API). Vacío = envío con enlace manual
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PLANTILLA=
CODIGO_PAIS=58
